@Misc{PosterCEN2025,
  bibtex_show={true},
  altmetric={false},
  abbr={Poster},
  title={Innovative approaches to 3D motion control in plasmonic nanomotors with optical pulling forces},
  author={Serrera, Guillermo and Tanaka, Yoshito Y. and Albella, Pablo},
  abstract={Recent advancements in nanophotonics have led to the use of scattering forces from plasmonic nanoantennas or dielectric metasurfaces to enable transverse two-dimensional motion. However, achieving control over longitudinal motion remains a significant challenge. Here, we introduce a novel nanomotor design that facilitates both transversal and longitudinal motion control. Our system relies on optical pulling forces by an azimuthally polarized Bessel beam on a glass cylinder, while asymmetric plasmonic dimers drive lateral motion under plane wave illumination.},
  note={Presented at CEN 2025. Abstract in 'PDF' button.},
  year={2025},
  award={Best theoretical poster award at CEN 2025.},
  award_name={Best Poster},
  preview={CEN2025Poster.png},
  pdf={CEN2025Abstract.pdf},
  poster={CEN2025Poster.pdf}
}

@Misc{PosterImagineNano2021,
  bibtex_show={true},
  altmetric={false},
  abbr={Poster},
  title={Grating metasurfaces as directional plasmon sources applications in achiral and chiral sensing},
  author={Serrera, Guillermo and González-Colsa, Javier and González, Francisco and Moreno, Fernando and Saiz, José María and Albella, Pablo},
  abstract={Optical biosensing is currently an intensively active research area, with an increasing demand of highly selective, sensitivity enhanced and low cost devices where different plasmonic approaches have been developed. In this work, we propose the use of a grating based gold metasurface that can act both, as a high sensitivity sensor device and as an unidirectional plasmon source. Furthermore, adding chiral HRID unit cells to another gold grating system, we demonstrate how the directional plasmon approach can be applied to chiral sensing, with a chiral structure that enhances chiroptical response.},
  note={Presented at Imagine Nano 3PM 2021. Abstract in 'PDF' button.},
  year={2021},
  preview={ImagineNano2021Poster.png},
  pdf={ImagineNano2021Abstract.pdf},
  poster={ImagineNano2021Poster.pdf}
}

@Misc{PosterMetanano2021,
  bibtex_show={true},
  altmetric={false},
  abbr={Poster},
  title={Enhanced chiroptical activity with dielectric chiral nanostructures: applications in racemic mixture sensing},
  author={Serrera, Guillermo and González-Colsa, Javier and González, Francisco and Moreno, Fernando and Saiz, José María and Albella, Pablo},
  abstract={We design a metasurface formed by chiral unit cell structures capable of enhancing the Circular Dichroism (CD) effect with high values of the CD signal in the far field regime and accesible high dissymmetry g-factor areas in the near field regime. The metasurface is then capable of emitting SPPs depending on the incident polarization. The chiral enhancement information is carried by the SPPs thus the enantiomeric proportion of a mixture can be inferred from the SPP intensity difference at both sides.},
  note={Presented at Metanano 2021. Abstract in 'PDF' button.},
  year={2021},
  preview={Metanano2021Poster.png},
  pdf={Metanano2021Abstract.pdf},
  poster={Metanano2021Poster.pdf}
}
