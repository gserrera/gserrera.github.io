@Misc{META25,
  bibtex_show={false},
  altmetric={false},
  abbr={META 2025},
  title={Optical pulling forces for 3-dimensional motion control in plasmonic nanomotors},
  author={Serrera, Guillermo and Tanaka, Yoshito Y. and Albella, Pablo},
  abstract={In this work, we present a novel nanomotor design that enables control over both transversal and longitudinal motion. The system utilizes a coupling mechanism between an azimuthally polarized Bessel beam and a dielectric glass cylinder, which serves also as a chassis for the nanomotor. Asymmetric plasmonic dimers are embedded within the cylinder in a way that minimizes their interaction with the pulling beam. This scheme allows for lateral motion, driven by the scattering forces from the plasmonic dimers under plane wave illumination, while Bessel beam incidence enables longitudinal motion through optical pulling forces on the cylinder. Our design unlocks a new degree of freedom in motion control, allowing for pulling, pushing, and lateral movement by adjusting the polarization or switching between plane waves and Bessel beams. Furthermore, the optical pulling force in our system is robust against rotational and translational disturbances, including Brownian motion, enhancing its practical applicability for advanced optical manipulation applications.},
  note={Invited talk at META 2025 (Torremolinos, Spain, 22-25 July 2025), Symposium II: New trends in nanophotonics and advanced materials. Full abstract in 'PDF' button.},
